# Copy to .env and fill in real values locally.
# Never commit .env. Set the same names in your host's Environment panel.

API_KEY=
API_BASE_URL=https://api.openai.com/v1
API_MODEL=gpt-4o-mini

APP_USERNAME=
APP_PASSWORD=

SESSION_SECRET=
PORT=3000
NODE_ENV=development

# Supabase Postgres — paste URI from Connect → Connection string → URI
DATABASE_URL=

# Optional Supabase API keys (not required for db:check)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
